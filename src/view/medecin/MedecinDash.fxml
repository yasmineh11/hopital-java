<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.MedecinController"
            stylesheets="@/resources/hopital-light.css">

    <left>
        <VBox styleClass="sidebar" prefWidth="215">

            <VBox styleClass="sidebar-header">
                <Label text="🏥  HôpitalApp" styleClass="sidebar-logo"/>
                <Label text="ESPACE MÉDECIN" styleClass="sidebar-role"/>
            </VBox>

            <VBox styleClass="sidebar-nav" VBox.vgrow="ALWAYS">
                <Label text="PRINCIPAL" styleClass="nav-section-label"/>
                <Button fx:id="btnDash"    text="  Tableau de bord"
                        onAction="#showDashboard"
                        prefWidth="199" styleClass="nav-btn"/>

                <Label text="MÉDICAL" styleClass="nav-section-label"/>
                <Button fx:id="btnRdv"     text="  Rendez-vous du jour"
                        onAction="#showRendezVous"
                        prefWidth="199" styleClass="nav-btn"/>
                <Button fx:id="btnConsult" text="  Nouvelle consultation"
                        onAction="#showConsultation"
                        prefWidth="199" styleClass="nav-btn"/>
                <Button fx:id="btnHisto"   text="  Historique patient"
                        onAction="#showHistorique"
                        prefWidth="199" styleClass="nav-btn"/>

                <Button text="  Déconnexion"
                        onAction="#logout"
                        prefWidth="199" styleClass="nav-btn-logout"/>
            </VBox>

            <VBox styleClass="sidebar-footer">
                <HBox styleClass="user-pill" alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="lblAvatar"   text="MD" styleClass="user-avatar"/>
                    <VBox>
                        <Label fx:id="lblUsername" text="medecin" styleClass="user-name"/>
                        <Label text="Médecin" styleClass="user-role-label"/>
                    </VBox>
                </HBox>
            </VBox>

        </VBox>
    </left>

    <center>
        <VBox styleClass="main-area">

            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12">
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="lblPageTitle" text="Tableau de bord"
                           styleClass="page-title"/>
                    <Label fx:id="lblPageSub"   text="Bienvenue"
                           styleClass="page-subtitle"/>
                </VBox>
                <Button fx:id="btnTheme" text="🌙"
                        onAction="#toggleTheme" styleClass="btn-theme"/>
            </HBox>

            <StackPane fx:id="centerPane"
                       VBox.vgrow="ALWAYS"
                       styleClass="content-area"/>
        </VBox>
    </center>

</BorderPane>
