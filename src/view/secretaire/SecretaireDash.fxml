<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.SecretaireController"
            stylesheets="@../../resources/hopital-light.css">

    <!-- ══════════════════════════════════
         SIDEBAR
    ══════════════════════════════════ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="215">

            <VBox styleClass="sidebar-header">
                <Label text="🏥  HôpitalApp" styleClass="sidebar-logo"/>
                <Label text="ESPACE SECRÉTAIRE" styleClass="sidebar-role"/>
            </VBox>

            <VBox styleClass="sidebar-nav" VBox.vgrow="ALWAYS">

                <Label text="PRINCIPAL" styleClass="nav-section-label"/>
                <Button fx:id="btnDash"      text="  Tableau de bord"
                        onAction="#showDashboard"
                        prefWidth="199" styleClass="nav-btn"/>

                <Label text="GESTION" styleClass="nav-section-label"/>
                <Button fx:id="btnPatients"  text="  Patients"
                        onAction="#showPatients"
                        prefWidth="199" styleClass="nav-btn"/>
                <Button fx:id="btnRdv"       text="  Rendez-vous"
                        onAction="#showRendezVous"
                        prefWidth="199" styleClass="nav-btn"/>

                <Label text="OUTILS" styleClass="nav-section-label"/>
                <Button fx:id="btnRecherche" text="  Recherche patient"
                        onAction="#showRecherche"
                        prefWidth="199" styleClass="nav-btn"/>

                <Button text="  Déconnexion"
                        onAction="#logout"
                        prefWidth="199" styleClass="nav-btn-logout"/>

            </VBox>

            <VBox styleClass="sidebar-footer">
                <HBox styleClass="user-pill" alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="lblAvatar"   text="SC" styleClass="user-avatar"/>
                    <VBox>
                        <Label fx:id="lblUsername" text="secretaire"
                               styleClass="user-name"/>
                        <Label text="Secrétaire médicale"
                               styleClass="user-role-label"/>
                    </VBox>
                </HBox>
            </VBox>

        </VBox>
    </left>

    <!-- ══════════════════════════════════
         ZONE CENTRALE
    ══════════════════════════════════ -->
    <center>
        <VBox styleClass="main-area">

            <!-- Topbar -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12">
                <VBox HBox.hgrow="ALWAYS">
                    <Label fx:id="lblPageTitle" text="Tableau de bord"
                           styleClass="page-title"/>
                    <Label fx:id="lblPageSub"
                           text="Gestion patients et rendez-vous"
                           styleClass="page-subtitle"/>
                </VBox>
                <TextField fx:id="tfSearch"
                           promptText="Rechercher un patient..."
                           styleClass="search-field"
                           prefWidth="210"/>
                <Button fx:id="btnPrimary"
                        text="+ Nouveau patient"
                        onAction="#handlePrimaryAction"
                        styleClass="btn-primary"/>
                <Button fx:id="btnTheme" text="🌙"
                        onAction="#toggleTheme"
                        styleClass="btn-theme"/>
            </HBox>

            <!-- Contenu dynamique -->
            <StackPane fx:id="centerPane"
                       VBox.vgrow="ALWAYS"
                       styleClass="content-area"/>

        </VBox>
    </center>

</BorderPane>
