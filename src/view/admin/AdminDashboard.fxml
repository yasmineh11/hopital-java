<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AdminController">

    <!-- Menu latéral -->
    <left>
        <VBox style="-fx-background-color:#1A5276; -fx-padding:20; -fx-spacing:10;"
              prefWidth="200">
            <Label text="👤 ADMIN" style="-fx-text-fill:white; -fx-font-weight:bold;"/>
            <Button text="🏠 Tableau de bord" onAction="#showDashboard"
                    prefWidth="160" style="-fx-background-color:#2E86C1; -fx-text-fill:white;"/>
            <Button text="👨‍⚕️ Médecins" onAction="#showMedecins"
                    prefWidth="160" style="-fx-background-color:#2E86C1; -fx-text-fill:white;"/>
            <Button text="👥 Utilisateurs" onAction="#showUtilisateurs"
                    prefWidth="160" style="-fx-background-color:#2E86C1; -fx-text-fill:white;"/>
            <Button text="📊 Statistiques" onAction="#showStats"
                    prefWidth="160" style="-fx-background-color:#2E86C1; -fx-text-fill:white;"/>
            <Button text="🚪 Déconnexion" onAction="#logout"
                    prefWidth="160" style="-fx-background-color:#E74C3C; -fx-text-fill:white;"/>
        </VBox>
    </left>

    <!-- Contenu central (chargé dynamiquement) -->
    <center>
        <StackPane fx:id="centerPane" style="-fx-padding:20;"/>
    </center>

</BorderPane>
